# Leave MONGODB_URI empty to auto-start an embedded persistent MongoDB (./.data/mongo)
MONGODB_URI=
JWT_SECRET=change-me-in-production-please-32chars

# Email links (invite / password reset) use the domain the request came in on.
# Optional: pin it, e.g. APP_URL=https://app.yourcompany.com
APP_URL=

# Profile photos (Cloudinary). Get these from the Cloudinary console -> API Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=
